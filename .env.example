# Copy this file to .env and fill it in. Never commit .env.
NEBIUS_API_KEY=

# Car link: the IP the ESP32 prints on its Serial Monitor
CAR_IP=192.168.1.60

# 1 = print car commands only, 0 = actually drive the car
DRY_RUN=1

# Capture card index (0, 1...), a video file, or a folder of photos
CAMERA_SOURCE=0

# Model ids (check with: python brain/vision_test.py --list)
EYES_MODEL=nvidia/Nemotron-3.5-Super-VL
PLANNER_MODEL=nvidia/Nemotron-3_5-Lightning
CHECK_MODEL=nvidia/Nemotron-3.5-Super-VL

# Models compared by vision_test.py (other open models are baselines only)
COMPARE_MODELS=nvidia/Nemotron-3.5-Super-VL,google/gemma-3-27b-it,openbmb/MiniCPM-V-4_5
